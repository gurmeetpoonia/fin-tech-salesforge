# Required
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://salesforge:salesforge@localhost:5432/salesforge?schema=public
DIRECT_URL=postgresql://salesforge:salesforge@localhost:5432/salesforge?schema=public
SHADOW_DATABASE_URL=postgresql://salesforge:salesforge@localhost:5432/salesforge_shadow?schema=public
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Redis / background jobs
REDIS_URL=redis://localhost:6379

# Optional integrations
GOOGLE_CLIENT_ID=
AI_URL=
AI_TIMEOUT=10000

# Email / Gmail SMTP (App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Legacy aliases supported by the notification email service
EMAIL_USER=
EMAIL_PASS=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
